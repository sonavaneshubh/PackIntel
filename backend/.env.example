SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Optional on Windows when Tesseract is not available in PATH.
TESSERACT_CMD=
# Optional multimodal fallback for low-confidence or incomplete OCR.
# Provider is configurable; keys are never exposed to the frontend.
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_SECONDS=30